@model IEnumerable<LanchesMac.Models.Lanche>

@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Produtos</h1>
    <a asp-action="Create" class="btn btn-primary">Novo produto</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var produto in Model)
    {
        <tr>
            <td>@produto.Nome</td>
            <td>@produto.Categoria?.CategoriaNome</td>
            <td>@produto.Preco.ToString("C")</td>
            <td>@(produto.EmEstoque ? "Sim" : "Não")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@produto.LancheId" class="btn btn-sm btn-outline-secondary">Editar</a>
                <form asp-action="Delete" asp-route-id="@produto.LancheId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir este produto?');">Excluir</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
