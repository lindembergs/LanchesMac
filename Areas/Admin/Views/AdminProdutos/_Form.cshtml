@model LanchesMac.Models.Lanche

<form asp-action="@(Model?.LancheId > 0 ? "Edit" : "Create")" method="post">
    <input asp-for="LancheId" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nome" class="form-label"></label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CategoriaId" class="form-label">Categoria</label>
        <select asp-for="CategoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Selecione uma categoria</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Preco" class="form-label"></label>
            <input asp-for="Preco" class="form-control" />
            <span asp-validation-for="Preco" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="EmEstoque" class="form-check-input" />
                <label asp-for="EmEstoque" class="form-check-label"></label>
            </div>
        </div>
        <div class="col-md-4 mb-3 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsLanchePreferido" class="form-check-input" />
                <label asp-for="IsLanchePreferido" class="form-check-label"></label>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="DescricaoCurta" class="form-label"></label>
        <input asp-for="DescricaoCurta" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ImagemUrl" class="form-label"></label>
        <input asp-for="ImagemUrl" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
