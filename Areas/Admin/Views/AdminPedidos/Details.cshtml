@model LanchesMac.Models.Pedido

@{
    ViewData["Title"] = $"Pedido #{Model.PedidoId}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Pedido #@Model.PedidoId</h1>
    <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</div>

<dl class="row">
    <dt class="col-sm-3">Cliente</dt>
    <dd class="col-sm-9">@Model.Nome @Model.Sobrenome</dd>
    <dt class="col-sm-3">E-mail</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Telefone</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>
    <dt class="col-sm-3">Endereço</dt>
    <dd class="col-sm-9">@Model.Endereco1, @Model.Cidade - @Model.Estado</dd>
</dl>

<h2 class="h4 mt-4">Itens</h2>
<table class="table table-sm">
    <thead>
        <tr>
            <th>Produto</th>
            <th>Quantidade</th>
            <th>Preço</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.PedidoItens ?? [])
    {
        <tr>
            <td>@item.Lanche?.Nome</td>
            <td>@item.Quantidade</td>
            <td>@item.Preco.ToString("C")</td>
            <td>@((item.Preco * item.Quantidade).ToString("C"))</td>
        </tr>
    }
    </tbody>
</table>

<p class="text-end fw-bold">Total: @Model.PedidoTotal.ToString("C")</p>
