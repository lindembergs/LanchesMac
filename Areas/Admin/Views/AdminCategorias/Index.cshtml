@model IEnumerable<LanchesMac.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Categorias</h1>
    <a asp-action="Create" class="btn btn-primary">Nova categoria</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Descrição</th>
            <th class="text-end">Ações</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var categoria in Model)
    {
        <tr>
            <td>@categoria.CategoriaNome</td>
            <td>@categoria.Descricao</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@categoria.CategoriaId" class="btn btn-sm btn-outline-secondary">Editar</a>
                <form asp-action="Delete" asp-route-id="@categoria.CategoriaId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Excluir esta categoria?');">Excluir</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
