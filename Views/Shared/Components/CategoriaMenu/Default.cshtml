<div class="dropdown">
    <a class="btn btn-secondary dropdown-toggle" href="#" role="button" id="dropdownMenuLink" data-bs-toggle="dropdown" aria-expanded="false">
        Lanches
    </a>

    <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
        <li>
            <a class="dropdown-item" asp-controller="Lanche" asp-action="List" style="color: black;">
                Ver todos os lanches
            </a>
        </li>
        @foreach(var categoria in Model){
            <li><a class="dropdown-item" asp-controller="Lanche" asp-action="List"
            style="color: black;" asp-route-categoria="@categoria.CategoriaNome">
            @categoria.CategoriaNome</a></li>
        }
    </ul>
</div>
